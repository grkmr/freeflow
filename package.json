{
	"name": "@grkmr/freeflow",
	"type": "module",
	"version": "0.0.0",
	"description": "React Flow graphs laid out automatically with ELK: routed edges, labels, markers and clickable edges.",
	"keywords": [
		"react",
		"react-flow",
		"xyflow",
		"elk",
		"graph",
		"layout",
		"diagram"
	],
	"author": "grkmr",
	"license": "MIT",
	"homepage": "https://github.com/grkmr/freeflow#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/grkmr/freeflow.git"
	},
	"bugs": {
		"url": "https://github.com/grkmr/freeflow/issues"
	},
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json",
		"./style.css": "./dist/style.css"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"play": "vite",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"prepublishOnly": "pnpm run build"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@tsconfig/strictest": "^2.0.8",
		"@tsdown/css": "^0.22.14",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/browser-playwright": "^4.1.10",
		"bumpp": "^11.1.0",
		"tsdown": "^0.22.5",
		"typescript": "^7.0.2",
		"vite": "^8.1.4",
		"vitest": "^4.1.10",
		"vitest-browser-react": "^2.2.0"
	},
	"dependencies": {
		"@xyflow/react": "^12.11.3",
		"elkjs": "^0.12.0"
	},
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
	"inlinedDependencies": {
		"@xyflow/react": "12.11.3"
	}
}
